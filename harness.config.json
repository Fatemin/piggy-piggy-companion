{
  "schema_version": 1,
  "project": "piggy-piggy-companion",
  "main_branch": "main",
  "remote": "origin",
  "session_numbering": {
    "commit_prefix": "^\\[(ST|AC|Q)\\d{4}\\] ",
    "branch_prefix": "^feature/(ST|AC|Q)\\d{4}-"
  },
  "entry_docs": [
    "CLAUDE.md",
    "docs/agent/README.md",
    "docs/agent/delivery.md",
    "docs/contracts/README.md"
  ],
  "tests": {
    "dir": "test",
    "suffix": ".test.js",
    "targeted": [
      "node",
      "--test"
    ],
    "full": [
      "npm",
      "test"
    ]
  },
  "impact": [
    {
      "paths": [
        "core.js",
        "data.js",
        "world.js",
        "ops.js"
      ],
      "tests": [
        "test/core.test.js",
        "test/ops.test.js",
        "test/host.test.js",
        "test/client.test.js",
        "test/features-cli.test.js",
        "test/contracts.test.js",
        "test/pens.test.js"
      ]
    },
    {
      "paths": [
        "store.js"
      ],
      "tests": [
        "test/host.test.js",
        "test/ops.test.js",
        "test/core.test.js",
        "test/features-cli.test.js",
        "test/contracts.test.js",
        "test/cloud.test.js"
      ]
    },
    {
      "paths": [
        "lib/**"
      ],
      "tests": [
        "test/cc.test.js",
        "test/i18n-adapter.test.js",
        "test/cloud.test.js"
      ]
    },
    {
      "paths": [
        "index.js"
      ],
      "tests": [
        "test/host.test.js",
        "test/features-cli.test.js",
        "test/contracts.test.js"
      ]
    },
    {
      "paths": [
        "client.js"
      ],
      "tests": [
        "test/client.test.js"
      ]
    },
    {
      "paths": [
        "art.js",
        "tools/build-sprites.mjs",
        "assets/**"
      ],
      "tests": [
        "test/contracts.test.js",
        "test/cc.test.js",
        "test/client.test.js",
        "test/core.test.js"
      ]
    },
    {
      "paths": [
        "render.js"
      ],
      "tests": [
        "test/i18n-render.test.js",
        "test/host.test.js"
      ]
    },
    {
      "paths": [
        "i18n.js",
        "locales/**"
      ],
      "tests": [
        "test/i18n-core.test.js",
        "test/i18n-render.test.js",
        "test/i18n-adapter.test.js",
        "test/contracts.test.js"
      ]
    },
    {
      "paths": [
        "bin/**",
        "hooks/**"
      ],
      "tests": [
        "test/cc.test.js",
        "test/features-cli.test.js"
      ]
    },
    {
      "paths": [
        "scripts/harness/**",
        "harness.config.json"
      ],
      "tests": [
        "test/harness.test.js",
        "test/session-number.test.js"
      ]
    },
    {
      "paths": [
        "docs/contracts/**"
      ],
      "tests": [
        "test/contracts.test.js"
      ]
    },
    {
      "paths": [
        "test/*.test.js"
      ],
      "tests": [
        "$self"
      ]
    },
    {
      "paths": [
        "server/**",
        "lib/cloud-proto.js",
        "ops.js"
      ],
      "tests": [
        "test/server.test.js",
        "test/ops.test.js",
        "test/cloud.test.js",
        "test/pens.test.js"
      ]
    }
  ],
  "gates": {
    "design": {
      "ui_paths": [
        "client.js",
        "render.js",
        "web/**",
        "app/pig/**",
        "app/main.mjs",
        "app/preload.cjs",
        "assets/**",
        "desktop/Sources/**",
        "tools/sprites.html",
        "tools/preview.html"
      ],
      "exclude": [
        "test/**"
      ],
      "handoff_glob": "docs/design/*design-handoff*.md"
    },
    "contracts": {
      "registry": "docs/contracts/README.md",
      "rules": [
        {
          "id": "HOST.SNAPSHOT.V1",
          "doc": "docs/contracts/host-snapshot.md",
          "triggers": [
            "index.js",
            "client.js"
          ]
        },
        {
          "id": "GAME.RULES.V1",
          "doc": "docs/contracts/game-rules.md",
          "triggers": [
            "core.js",
            "data.js",
            "world.js"
          ]
        },
        {
          "id": "STORE.SAVE.V6",
          "doc": "docs/contracts/save-format.md",
          "triggers": [
            "store.js",
            "lib/lock.js"
          ]
        },
        {
          "id": "I18N.TERMS.V1",
          "doc": "docs/contracts/i18n.md",
          "triggers": [
            "i18n.js",
            "locales/GLOSSARY.md"
          ]
        },
        {
          "id": "ART.ASSETS.V1",
          "doc": "docs/contracts/art-assets.md",
          "triggers": [
            "art.js",
            "tools/build-sprites.mjs",
            "assets/**"
          ]
        }
      ]
    },
    "docs_sync": {
      "groups": [
        {
          "name": "README trilingual",
          "paths": [
            "README.md",
            "README.en.md",
            "README.ja.md"
          ]
        }
      ]
    }
  },
  "release": {
    "version_file": "package.json",
    "changelog": "CHANGELOG.md",
    "changelog_heading": "^## \\[(?<version>\\d+\\.\\d+\\.\\d+)\\]",
    "tag_prefix": "v"
  }
}
